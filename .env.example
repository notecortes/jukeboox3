# =====================================================================
# AuraBox - Plantilla de Variables de Entorno y Configuración NAS
# Copia este archivo como .env (cp .env.example .env) y rellena tus datos
# =====================================================================

PORT=4080
HTTPS_PORT=4443
HTTPS_PUBLIC_PORT=4443
FORCE_HTTPS=false
TLS_EXTRA_HOSTS=
ADMIN_PORT=4081

# Configuración de Red NAS (SMB / CIFS)
NAS_ALIAS=mi-nas
NAS_HOST=192.168.1.100
NAS_SHARE=music
NAS_USER=tu_usuario_nas
NAS_PASS=tu_contraseña_nas
NAS_OPTIONS=vers=3.0,sec=ntlmssp,ro,iocharset=utf8

# Audio local del host Linux (PulseAudio / PipeWire)
# En Raspberry Pi (ALSA directo) déjalo en /dev/null. En Linux escritorio usa /run/user/1000/pulse/native
PULSE_SOCKET=/dev/null
PULSE_COOKIE=/dev/null

